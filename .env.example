# LLM provider selection (src/llm_client.py). "ollama" (default) uses a
# local Ollama install, no token needed. "huggingface" uses the Hugging
# Face Inference Providers free tier and requires HF_TOKEN below.
LLM_PROVIDER=ollama

# Ollama settings (only used when LLM_PROVIDER=ollama). Defaults match
# this project's own local setup -- override only if yours differs.
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# Hugging Face API token (huggingface_hub SDK, Inference Providers free
# tier) -- only used when LLM_PROVIDER=huggingface.
HF_TOKEN=
